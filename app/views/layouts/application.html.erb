<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mconf Bibleoteca" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mconf Bibleoteca">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= yield :head %>

    <%# Manifesto PWA para instalação do aplicativo. Também exige uma rota em config/routes.rb. %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">

    <%# O Vite só é necessário nas páginas React renderizadas pelo Inertia. %>
    <% if inertia_rendering? %>
      <%= vite_client_tag %>
      <%= vite_react_refresh_tag %>
      <%= vite_javascript_tag "inertia.tsx" %>
    <% end %>
  </head>

  <body>
    <%= inertia_rendering? ? inertia_root : yield %>
  </body>
</html>
