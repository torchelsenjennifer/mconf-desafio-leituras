<main class="auth-page">
  <section class="auth-intro" aria-hidden="true">
    <p class="auth-kicker">Biblioteca coletiva</p>
    <h1>Boas leituras merecem ser compartilhadas.</h1>
    <p>Entre para continuar adicionando livros e cuidando da sua parte da estante.</p>
  </section>

  <section class="auth-card" aria-labelledby="signin-title">
    <%= link_to "← Voltar para a estante", root_path, class: "auth-back" %>
    <p class="auth-kicker">Que bom ter você aqui</p>
    <h2 id="signin-title">Entrar</h2>
    <p class="auth-subtitle">Informe seus dados para continuar.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <div class="auth-field">
        <%= f.label :email, "E-mail" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "voce@exemplo.com" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "Senha" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "Sua senha" %>
      </div>

      <%= f.submit "Entrar na biblioteca", class: "auth-submit" %>
    <% end %>

    <p class="auth-secondary">Ainda não participa? <%= link_to "Criar conta", new_registration_path(resource_name) %></p>
  </section>
</main>
