<main class="auth-page">
  <section class="auth-intro" aria-hidden="true">
    <p class="auth-kicker">Biblioteca coletiva</p>
    <h1>Seu próximo livro favorito pode estar aqui.</h1>
    <p>Crie sua conta para adicionar leituras e construir esta estante com a comunidade.</p>
  </section>

  <section class="auth-card" aria-labelledby="signup-title">
    <%= link_to "← Voltar para a estante", root_path, class: "auth-back" %>
    <p class="auth-kicker">Comece agora</p>
    <h2 id="signup-title">Criar conta</h2>
    <p class="auth-subtitle">São só alguns dados para participar.</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field">
        <%= f.label :name, "Como podemos chamar você?" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Seu nome" %>
      </div>

      <div class="auth-field">
        <%= f.label :email, "E-mail" %>
        <%= f.email_field :email, autocomplete: "email", placeholder: "voce@exemplo.com" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "Senha" %>
        <% if @minimum_password_length %>
          <span class="auth-hint">Mínimo de <%= @minimum_password_length %> caracteres.</span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "Crie uma senha segura" %>
      </div>

      <%= f.submit "Criar minha conta", class: "auth-submit" %>
    <% end %>
  </section>
</main>
